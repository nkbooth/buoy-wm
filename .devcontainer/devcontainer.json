  //
  // The default config: everything `cargo build`, `cargo test`, `cargo
  // clippy` and `pre-commit` need, and nothing else. The Rust toolchain
  // lives only in this container — buoy-wm never assumes a host-installed
  // cargo. libwayland-dev + pkg-config are required to link
  // wayland-client/wayland-backend (wm/Cargo.toml deps).
  //
  // Deliberately does NOT mount the host's container socket. Ordinary
  // build/test/lint needs no container engine, and a bind-mounted rootless
  // Podman socket lets anything in here — an agent, an `act` job, a
  // malicious dependency's build.rs during `cargo build` — create host
  // containers with arbitrary bind mounts, i.e. take the host user account.
  // Local CI runs that genuinely need it use .devcontainer/act instead.
  "name": "buoy-wm",
  "image": "mcr.microsoft.com/devcontainers/rust:1",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "workspaceFolder": "/workspaces/buoy-wm"
}
