#
# The packaged session's init: river runs this file (`river -c
# /usr/libexec/buoy-wm/buoy-session`) as a process-group leader once its
# Wayland socket exists, so WAYLAND_DISPLAY is already set here.
#
# It supervises buoy-wm instead of exec'ing it (ADR-010). An exec'd WM
# has nobody left to stop buoy-session.target when it exits, so the
# portals and everything else bound to graphical-session.target keep
# running against a dead socket into the next login. Keeping this shell
# alive costs one process and lets the target follow the WM's lifetime.
#
# Two targets are stopped at the end, in this order. buoy-session.target
# is ours and is the thing the trap can stop early. graphical-session.target
# is StopWhenUnneeded=yes but stays pinned while any active unit
# Requisite=s it (Fedora's xdg-desktop-portal.service and waybar.service
# do), so it never becomes unneeded on its own: its PartOf= units are never
# stopped, they die on the vanished socket and hit the start limit, and the
# main portal outlives the session into a re-login within logind's stop
# delay (measured 2026-11-07). It refuses a manual start
# (RefuseManualStart=yes), not a manual stop, so the explicit stop is
# allowed; it is also what GNOME's gnome-session-shutdown.target
# (/usr/lib/systemd/user/, Conflicts=graphical-session.target) does. The
# user manager is per user, not per login, so the stop reaches every unit
# under graphical-session.target: a second graphical session of the same
# user (another VT, or this session nested under another compositor)
# loses its portals and bar with ours.
#
# The WM runs in the background and is `wait`ed on, rather than in the
# foreground, so that a signal to this pid alone is forwarded: a shell
# defers a trap while a foreground child runs, and river only SIGTERMs
# the whole group on its own exit. INT and HUP are forwarded as TERM
# because an asynchronous child of a non-interactive shell ignores SIGINT
# (POSIX XCU 2.11) and buoy-wm handles no signal anyway, so SIGTERM's
# default action is the only way it ever ends.
#
# No `set -e`: a systemd problem must degrade the session (no portals),
# never abort the login with no shell left to recover from. Every systemd
# step is reported on stderr, which lands in the journal, and skipped.
set -u

# buoy-wm is a sibling of this file, never a PATH lookup, so the three
# binaries always come from the same installed directory.
wm_dir=$(dirname -- "$0")
session_vars='WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP'

# The traps are installed before the systemd steps, not just before the
# launch: a shell defers a trap until the foreground command returns, so a
# TERM during `systemctl start` would otherwise kill this script with the
# target already started and nobody left to stop it. Before the WM exists
# the trap stops both targets and exits: the first is a no-op if the start
# never ran, the second takes down whatever a previous login left pinned
# under graphical-session.target, which is the point;
# once it exists the signal is forwarded and the wait loop below carries
# on. The one-command gap between `&` and `wm_pid=$!` is the only window
# left, and a signal there kills this script with the WM just launched.
wm_pid=''
signalled=0
trap 'signalled=1
    if [ -n "$wm_pid" ]; then
        kill -s TERM "$wm_pid" 2>/dev/null || :
    else
        systemctl --user stop buoy-session.target 2>/dev/null || :
        systemctl --user stop graphical-session.target 2>/dev/null || :
        exit 143
    fi' TERM INT HUP

# All five names are passed unconditionally: both tools ignore a name that
# is not set in the environment (DISPLAY is unset without Xwayland).
# shellcheck disable=SC2086  # $session_vars is a deliberate word list
systemctl --user import-environment $session_vars \
    || echo 'buoy-session: systemctl --user import-environment failed; portals may not see the session' >&2
# shellcheck disable=SC2086
dbus-update-activation-environment --systemd $session_vars \
    || echo 'buoy-session: dbus-update-activation-environment failed' >&2
systemctl --user start buoy-session.target \
    || echo 'buoy-session: could not start buoy-session.target' >&2

"$wm_dir/buoy-wm" &
wm_pid=$!

# A trapped signal returns from `wait` before the WM has gone, so wait
# again in that case only; the flag decides, not the status. The trap can
# also fire just after `wait` has reported the real status: the job is
# gone by then, and a second wait on it returns 127 in bash (dash repeats
# the status), so a 127 after a status has already been collected keeps
# the collected one rather than replacing it. A 127 with nothing collected
# is real: buoy-wm could not be executed.
status=''
while :; do
    signalled=0
    wait "$wm_pid" 2>/dev/null
    rc=$?
    if [ "$rc" -eq 127 ] && [ -n "$status" ]; then
        break
    fi
    status=$rc
    [ "$signalled" -eq 1 ] || break
done

# The traps stay installed: a second signal during the stops is forwarded
# to a pid that is gone (a no-op) instead of killing this script before it
# can exit with the WM's status. Both stops are synchronous: a stop that
# returned before the portal was gone would hand the next login a dead
# socket again. The second stop is what actually ends the session (see the
# header): stopping buoy-session.target alone leaves graphical-session.target
# active and its PartOf= units unstopped, so they die on the socket and hit
# the start limit while the portal, which needs no socket, keeps running.
systemctl --user stop buoy-session.target \
    || echo 'buoy-session: could not stop buoy-session.target' >&2
systemctl --user stop graphical-session.target \
    || echo 'buoy-session: could not stop graphical-session.target' >&2
exit "$status"
